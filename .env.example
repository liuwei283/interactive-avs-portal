# Copy to .env.local for local development. These values are PUBLIC by design:
# they end up in the browser bundle. Never put a service-role / secret key here.

# Supabase project URL and anon (or "publishable") key — Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Email of the Supabase Auth user that the fixed username "admin" maps to.
VITE_ADMIN_EMAIL=admin@example.org

# Optional
VITE_SITE_TITLE=Research Portal
VITE_MAX_UPLOAD_MB=50

# GitHub Pages subpath for local production-like builds, e.g. /interactive-avs-portal/
# BASE_PATH=/
